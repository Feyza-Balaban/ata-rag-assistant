ATA_CHUNKS_PATH=scraper/output/chunks.jsonl
ATA_TOP_K=5
ATA_CONFIDENCE_THRESHOLD=0.15
ATA_BACKEND_API_KEY=
ATA_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Optional grounded answer generation. Local extractive mode is used if blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional semantic retrieval. BM25 remains available when the DB URL is blank.
ATA_VECTOR_DATABASE_URL=postgresql://ata:ata@127.0.0.1:5433/ata_rag
ATA_EMBEDDING_PROVIDER=local
ATA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ATA_EMBEDDING_DIMENSIONS=384
ATA_VECTOR_SIMILARITY_THRESHOLD=0.55

# Frontend connection
ATA_RAG_API_URL=http://127.0.0.1:8000/ask
ATA_RAG_API_KEY=
